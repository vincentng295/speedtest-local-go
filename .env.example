# Copy to .env (next to the binary or in the working directory).
# Real environment variables take priority over this file.

# Bind address / port
HOST=0.0.0.0
PORT=8080

# Text shown in the UI
SPEEDTEST_ISP=Local Network
SPEEDTEST_SERVER_NAME=My Speedtest Server
SPEEDTEST_LOCATION=LAN

# Max size of one /api/download request (MB)
MAX_DOWNLOAD_MB=1024

# Set to 1 behind nginx / cloudflared to read the real client IP
TRUST_PROXY=0
